{
  "name": "ai-image-detection-blockchain",
  "version": "1.0.0",
  "description": "Blockchain integration for AI Image Detection platform using Ethereum and Solidity",
  "main": "index.js",
  "scripts": {
    "test": "hardhat test",
    "test:gas": "REPORT_GAS=true hardhat test",
    "test:coverage": "hardhat coverage",
    "deploy:local": "hardhat run scripts/blockchain/deploy.js --network localhost",
    "deploy:sepolia": "hardhat run scripts/blockchain/deploy.js --network sepolia",
    "verify:sepolia": "hardhat verify --network sepolia",
    "node": "hardhat node",
    "clean": "hardhat clean",
    "compile": "hardhat compile",
    "console:sepolia": "hardhat console --network sepolia"
  },
  "keywords": [
    "blockchain",
    "ethereum",
    "solidity",
    "ai",
    "voting",
    "decentralized"
  ],
  "author": "Jay Parmar",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "hardhat": "^2.27.0",
    "hardhat-gas-reporter": "^2.3.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.4.0",
    "dotenv": "^17.2.3",
    "ethers": "^6.15.0"
  }
}
